{
  "name": "roll20-paladinaura",
  "version": "2.0.0",
  "description": "A Roll20 API for applying and displaying Paladin Aura bonuses based on proximity",
  "main": "PaladinAura.js",
  "scripts": {
    "build": "npm run test && npm run lint:fix && npm run build:nocheck",
    "build:nocheck": "npm run create-target-file-without-externals & npm run build-generated-target-file & npm run delete-generated-target-file",
    "test": "jest",
    "lint": "prettier ./src/**/*.ts --check && eslint ./src/**/*.ts",
    "lint:fix": "prettier ./src/**/*.ts --write && eslint ./src/**/*.ts --fix",
    "create-target-file-without-externals": "sed -E \"s/export\\s+|(import|declare) .+?;//g\" ./src/index.ts > ./src/target.ts",
    "build-generated-target-file": "tsc ./src/target.ts --outFile ./PaladinAura.js --target es2019 --module amd",
    "delete-generated-target-file": "rm ./src/target.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/LaytonGB/Paladin-Aura-API.git"
  },
  "author": "Layton Burchell",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/LaytonGB/Paladin-Aura-API/issues"
  },
  "homepage": "https://gitlab.com/LaytonGB/Paladin-Aura-API#readme",
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/lodash": "^4.14.196",
    "@types/roll20": "github:LaytonGB/types-roll20",
    "@types/roll20-led": "file:../led",
    "@types/roll20-locs": "file:../locs",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "eslint": "^8.43.0",
    "jest": "^29.6.1",
    "lodash": "^4.17.21",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.5"
  }
}
